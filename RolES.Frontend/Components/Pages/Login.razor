@page "/login"
@using RolES.Frontend.Modelos
@rendermode InteractiveServer 
@inject HttpClient http 

<h1>Login</h1>
<form @onsubmit="EnviarDadosParaApi">
    
    <label>
        E-mail
        <input  type="email" required @bind-value="dadosEnvio.Email"/>
    </label>
    
    <label>
        Senha
        <input type="password" required autocomplete="current-password"@bind-value="dadosEnvio.Senha"/>
    </label>
    <button type="submit">Entrar</button>
</form>

@code 
{ 
    private LoginModelo dadosEnvio = new();

    private async Task EnviarDadosParaApi()
    {
        var resposta = await http.PostAsJsonAsync("http://10.112.4.157/login", dadosEnvio);

        if (resposta.IsSuccessStatusCode)
        { 
            navegador.NavigateTo("/perfil");
        }
        else
        {
            Console.WriteLine("Login mal sucedido!");
        }
    }
    
}